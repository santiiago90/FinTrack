          "expr": "histogram_quantile(0.95, sum by (le) (rate(fintrack_db_operation_duration_seconds_bucket[30s])))",
          "legendFormat": "PostgreSQL p95 (todas as operações)",
          "range": true
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Pool de ligações PostgreSQL",
