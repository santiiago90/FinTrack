      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fintrack-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fintrack_http_request_duration_seconds_bucket{route=~\"/api/expenses.*\"}[30s])))",
          "legendFormat": "HTTP p95 /api/expenses*",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "fintrack-prometheus"
