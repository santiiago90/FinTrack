# Copiar para backend/.env. Apenas para utilização local de um único utilizador.
PORT=3000
HOST=127.0.0.1
FRONTEND_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintrack
DB_USER=fintrack
DB_PASSWORD=replace_with_local_password
# Tempo máximo (ms) para obter uma ligação e para cada query.
DB_CONNECTION_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=5000
