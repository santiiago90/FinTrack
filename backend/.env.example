
# =====================================
# FinTrack - Configuração do Ambiente
# =====================================

# Configurações do servidor Backend
NODE_ENV=development
PORT=3000

# Configurações da base de dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fintrack
DB_USER=fintrack
DB_PASSWORD=change_me

# Configurações de autenticação
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1h

# Endereço da API utilizado pelo Frontend
VITE_API_URL=http://localhost:3000/api

# Configurações da Inteligência Artificial
AI_API_KEY=your_api_key_here
AI_MODEL=your_model_here
